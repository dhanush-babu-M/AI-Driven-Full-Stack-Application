# PathPilot Backend Environment Variables (copy to .env and fill in real values)
# NEVER commit your real .env file to Git!

SPRING_PROFILES_ACTIVE=local

# MySQL Database (localhost)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pathpilot
DB_USERNAME=root
DB_PASSWORD=

# CORS (comma-separated known frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Authentication / JWT (use a long random secret >= 32 characters in production)
JWT_SECRET=replace-with-a-random-32-plus-char-secret-key
JWT_EXPIRATION_MINUTES=30
JWT_COOKIE_NAME=pathpilot_token
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax

# Auth Rate Limiting (per IP)
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Future Phases (leave empty in Phase 1/2)
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-a-random-32-char-secret-for-github-pat-aes
